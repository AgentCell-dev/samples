# This file must NOT be published. A static cell leaves out every path segment that begins with
# "." except .well-known, so GET /.env on the deployed site must answer 404 (this site's 404.html).
# The value is not a secret: it is a canary a check can search for in a response body.
AGENTCELL_SAMPLE_UNPUBLISHED=static-plain-dotfile-canary
